---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpeg';
import ContactButtons from '../components/ContactButtons.astro';
import { noWidow, typograf } from '../lib/typograf.mjs';
import { url } from '../lib/url';

/*
  Страница 404: шапка (портрет, имя и роль — ссылка на главную; справа CV и
  Telegram), одна колонка по центру экрана, внизу футер как на остальных страницах. Гифка из public/404/; при «уменьшить движение» вместо неё статичная
  картинка (выбирает браузер через <picture>, гифка тогда даже не загружается).
*/
---

<Base title="Страница не найдена — Валентина Тельбизова">
  <!--
    Шапка и футер прижаты к краям экрана, блок с котиком — ровно по центру экрана.
    Отступ main сверху и снизу одинаковый и не меньше высоты шапки и футера,
    поэтому блок на них не наезжает и на невысоком экране всё помещается
  -->
  <div class="relative min-h-svh">
    <header class="absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-3 px-4 pt-6 md:px-8">
      <a href={url('/')} class="flex items-center gap-3 rounded-pill outline-offset-4">
        <!-- Портрет с тем же кадрированием, что на первом экране главной -->
        <span class="relative size-11 shrink-0 overflow-hidden rounded-pill bg-surface">
          <Image
            src={portrait}
            alt=""
            widths={[38, 76]}
            sizes="38px"
            format="webp"
            class="absolute top-[0.26%] left-[7.66%] h-auto w-[84.69%] max-w-none"
          />
        </span>
        <!-- На телефоне имя не помещается рядом с кнопками — остаётся только портрет -->
        <span class="flex flex-col gap-1 text-left max-sm:sr-only">
          <span class="text-button-sm font-medium">Валентина Тельбизова</span>
          <span class="text-nav text-fg/50">UX/UI-дизайнер</span>
        </span>
      </a>
      <ContactButtons size="sm" />
    </header>

    <main class="flex min-h-svh items-center justify-center px-4 py-24">
      <div class="flex w-full max-w-lead flex-col items-center text-center">
        <picture>
          <source srcset={url('/404/404-static.png')} media="(prefers-reduced-motion: reduce)" />
          <img src={url('/404/404.gif')} width="220" height="220" alt="Котик печатает" class="size-55 max-w-none rounded-card-sm" />
        </picture>

        <h1 class="mt-10 text-hero-xs font-normal text-balance md:mt-12 md:text-hero">{typograf('Страницы нет, зато есть вайб')}</h1>
        <p class="mt-3 text-body-sm text-fg/60 md:mt-4 md:text-prose">{noWidow(typograf('Сайт был навайбкожен, иногда это чувствуется'))}</p>

        <!-- Кнопка как CV и Telegram на первом экране -->
        <a href={url('/')} class="mt-8 inline-flex h-13 items-center rounded-button bg-accent px-5 text-button font-medium text-surface transition-[background-color,scale] duration-(--dur-micro) ease-(--ease-out) hover:bg-fg active:scale-97 active:bg-fg md:mt-8">
          <span class="pb-px">Вернуться на главную</span>
        </a>
      </div>
    </main>

    <div class="absolute inset-x-0 bottom-0">
      <Footer class="pb-8 md:pb-10" />
    </div>
  </div>
</Base>
