---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHeader from '../../components/case/CaseHeader.astro';
import CaseToc from '../../components/case/CaseToc.astro';
import Footer from '../../components/Footer.astro';
import ScrollTopButton from '../../components/ScrollTopButton.astro';
import CasePlaceholder from '../../components/case/CasePlaceholder.astro';
import NextCaseBar from '../../components/case/NextCaseBar.astro';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);

  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'cases'>;
  next: CollectionEntry<'cases'>;
}

const { entry, next } = Astro.props;
---

<Base title={`${entry.data.title} — Валентина Тельбизова`}>
  <CaseHeader />
  <CaseToc />

  <main class="px-4">
    <article class="mx-auto flex max-w-page flex-col gap-10 pt-17">
      <header class="flex flex-col items-center gap-5 text-center md:px-15">
        <h1 id="case-title" class="text-hero-sm font-normal md:text-case-title" data-reveal>{entry.data.title}</h1>
        <p class="text-prose text-fg/60" data-reveal style="--reveal-delay: 80ms">{entry.data.description}</p>
      </header>

      <CasePlaceholder />
    </article>
  </main>

  <Footer class="pb-10" />
  <NextCaseBar href={`/cases/${next.id}`} />
  <ScrollTopButton />
</Base>
