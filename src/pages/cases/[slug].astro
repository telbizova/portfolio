---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHeader from '../../components/case/CaseHeader.astro';
import CaseToc from '../../components/case/CaseToc.astro';
import Footer from '../../components/Footer.astro';
import ScrollTopButton from '../../components/ScrollTopButton.astro';
import CaseAbout from '../../components/case/CaseAbout.astro';
import CaseHero from '../../components/case/CaseHero.astro';
import CasePlaceholder from '../../components/case/CasePlaceholder.astro';
import { caseSections } from '../../components/case/sections';
import NextCaseBar from '../../components/case/NextCaseBar.astro';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);

  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'cases'>;
  next: CollectionEntry<'cases'>;
}

const { entry, next } = Astro.props;
const { data } = entry;

// Кейс с контентом: «О проекте» + разделы из заголовков второго уровня в тексте.
// Кейс без контента: заглушка из макета со своим набором разделов
const { Content, headings } = await render(entry);
const hasContent = Boolean(data.about);
const sections = hasContent
  ? [{ id: 'about', title: 'О проекте' }, ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, title: h.text }))]
  : caseSections;
---

<Base title={`${entry.data.title} — Валентина Тельбизова`}>
  <CaseHeader />
  <CaseToc sections={sections} />

  <main class="px-4">
    <article class="mx-auto flex max-w-page flex-col gap-10 pt-17">
      <header class="flex flex-col items-center gap-5 text-center md:px-15">
        <h1 id="case-title" class="text-hero-sm font-normal md:text-case-title" data-reveal>{entry.data.title}</h1>
        <p class="text-prose text-fg/60" data-reveal style="--reveal-delay: 80ms">{entry.data.description}</p>
      </header>

      {hasContent ? (
        <div class="flex flex-col gap-17">
          <div class="flex flex-col gap-8">
            {data.hero ? (
              <CaseHero src={data.hero} alt={data.heroAlt ?? data.title} />
            ) : (
              <figure class="case-figure" data-reveal>
                <div class="case-figure__frame" role="img" aria-label="Скриншот: обложка кейса" />
              </figure>
            )}
            <CaseAbout about={data.about!} note={data.note} />
          </div>
          <div class="case-prose">
            <Content />
          </div>
        </div>
      ) : (
        <CasePlaceholder />
      )}
    </article>
  </main>

  <Footer class="pb-10" />
  <NextCaseBar href={`/cases/${next.id}`} />
  <ScrollTopButton />
</Base>
