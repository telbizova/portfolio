---
import Arrow from './Arrow.astro';
import { url } from '../lib/url';

interface Props {
  /*
    lg — кнопки первого экрана: 52px, скругление 12, текст 17, стрелка 18.
    sm — в плавающей плашке и шапке кейса: 44px, скругление 8, текст 15, стрелка 16.
  */
  size?: 'lg' | 'sm';
  // В плавающей плашке между кнопками — вертикальный разделитель
  divider?: boolean;
}

const { size = 'lg', divider = false } = Astro.props;
const lg = size === 'lg';

// Резюме лежит в public/cv/, ссылки открываются в новой вкладке
const links = [
  { href: url('/cv/telbizova-cv.pdf'), label: 'CV' },
  { href: 'https://t.me/telbizova', label: 'Telegram' },
];
---

<ul class="flex items-center justify-center gap-3">
  {links.map(({ href, label }, i) => (
    <>
      {divider && i > 0 && <li class="h-6 w-px bg-line" aria-hidden="true" />}
      <li>
        <a
          href={href}
          target="_blank"
          rel="noopener"
          class:list={[
            'group/link inline-flex items-center gap-1.5 bg-accent font-medium text-surface transition-[background-color,scale] duration-(--dur-micro) ease-(--ease-out) hover:bg-fg active:scale-97 active:bg-fg',
            lg ? 'h-13 rounded-button px-5 text-button' : 'h-11 rounded-square px-4 text-button-sm',
          ]}
        >
          <!--
            Текст чуть выше центра, как в макете (сверено по контурам букв в Figma):
            в кнопке 52 верх букв 19 / линия букв 20.3 от низа, в кнопке 44 — 15.4 / 17.4
          -->
          <span class:list={[lg ? 'pb-px' : 'pb-0.5']}>{label}</span>
          <Arrow size={lg ? 'lg' : 'md'} />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      </li>
    </>
  ))}
</ul>
