---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpeg';
import ContactButtons from './ContactButtons.astro';
---

<section aria-labelledby="hero-title" class="flex flex-col items-center gap-7 px-4 pt-6 text-center md:pt-12.5">
  <!--
    Кадрирование как в макете: фото 101.6×135.5 внутри круга 120 на белой
    подложке, сдвиг 9.2px слева (imageTransform слоя Photo)
  -->
  <div class="relative size-avatar shrink-0 overflow-hidden rounded-pill bg-surface" data-reveal>
    <Image
      src={portrait}
      alt="Портрет Валентины Тельбизовой: тёмные волосы до плеч, серая рубашка"
      widths={[102, 204]}
      sizes="102px"
      format="webp"
      class="absolute top-[0.26%] left-[7.66%] h-auto w-[84.69%] max-w-none"
    />
  </div>

  <div class="flex w-full max-w-page flex-col items-center gap-6" data-reveal style="--reveal-delay: 80ms">
    <h1 id="hero-title" class="text-hero-sm font-normal md:text-hero">
      Привет, я Валентина!<br />
      UX/UI-дизайнер нагруженных систем<br />
      для B2B/B2E
    </h1>
    <p class="max-w-lead text-body text-fg/50 md:text-lead">
      Аналитические системы, дашборды, конструкторы, внутренние инструменты. 4+ года делаю так, чтобы в плотных данных было легко ориентироваться
    </p>
  </div>

  <div id="hero-contacts" data-reveal style="--reveal-delay: 160ms">
    <ContactButtons />
  </div>
</section>

<!-- Плашка «Button-bar» из фрейма «Главная-скролл»: появляется, когда кнопки первого экрана ушли из вида -->
<div
  id="floating-contacts"
  class="fixed bottom-5 left-1/2 z-10 -translate-x-1/2 rounded-bar border border-bar-stroke/70 bg-glass/20 p-3 backdrop-blur-[8px] transition-[opacity,translate] duration-(--dur-slide) ease-(--ease-spring) not-data-[shown]:pointer-events-none not-data-[shown]:translate-y-[calc(100%+var(--spacing)*5)] not-data-[shown]:opacity-0"
  inert
>
  <ContactButtons size="sm" divider />
</div>

<script>
  const anchor = document.getElementById('hero-contacts');
  const floating = document.getElementById('floating-contacts');

  const footer = document.getElementById('site-footer');

  if (anchor && floating) {
    // Показываем, когда кнопки первого экрана ушли вверх, и прячем у футера,
    // чтобы плашка его не перекрывала
    let pastAnchor = false;
    let nearFooter = false;
    const render = () => {
      const show = pastAnchor && !nearFooter;
      floating.toggleAttribute('data-shown', show);
      floating.inert = !show;
    };

    new IntersectionObserver(([entry]) => {
      pastAnchor = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      render();
    }).observe(anchor);

    if (footer) {
      new IntersectionObserver(([entry]) => {
        nearFooter = entry.isIntersecting;
        render();
      }).observe(footer);
    }
  }
</script>
