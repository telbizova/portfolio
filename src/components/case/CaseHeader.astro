---
import Arrow from '../Arrow.astro';
import ContactButtons from '../ContactButtons.astro';
import { url } from '../../lib/url';
---

<!-- От 1280px шапка закреплена по краям экрана, как в макете; уже — идёт блоком над колонкой -->
<header class="flex items-center justify-between gap-3 px-4 pt-6 xl:fixed xl:inset-x-8 xl:top-6 xl:z-10 xl:px-0 xl:pt-0">
  <a href={url('/')} class="group/link flex items-center gap-2 text-nav font-medium whitespace-nowrap text-fg/70 transition-colors duration-(--dur-micro) ease-(--ease-out) hover:text-fg active:text-fg">
    <Arrow rotate={225} size="sm" />
    <!-- На телефоне сокращаем, чтобы ссылка и кнопки встали в одну строку -->
    <span class="sm:hidden" aria-hidden="true">Назад</span>
    <span class="max-sm:sr-only">Назад в портфолио</span>
  </a>
  <ContactButtons size="sm" />
</header>
