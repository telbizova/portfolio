---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Первая картинка кейса: готовая карточка 700×393 (белая подложка и скругления уже в файле)
interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="case-figure" data-reveal>
  <Image src={src} alt={alt} widths={[700, 1400, 2100]} sizes="(min-width: 768px) 700px, calc(100vw - 32px)" />
</figure>
