---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Первая картинка кейса: белая карточка 700×393, внутри по центру скриншот 533×300
interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="case-figure" data-reveal>
  <div class="case-figure__frame">
    <Image src={src} alt={alt} widths={[533, 1066, 1600]} sizes="(min-width: 768px) 533px, 76vw" />
  </div>
</figure>
