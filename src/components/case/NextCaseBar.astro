---
import Arrow from '../Arrow.astro';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<!-- Плашка «Button-bar» из фрейма «Страница проекта - скролл»: появляется, когда шапка кейса ушла из вида -->
<a
  id="next-case"
  href={href}
  class="group/link fixed bottom-8 left-1/2 z-10 flex h-11 -translate-x-1/2 items-center gap-1.5 rounded-square border border-bar-stroke/70 bg-surface/60 px-4 text-button-sm font-medium whitespace-nowrap backdrop-blur-[8px] transition-[opacity,translate,scale] active:scale-97 duration-(--dur-slide) ease-(--ease-spring) not-data-[shown]:pointer-events-none not-data-[shown]:translate-y-[calc(100%+var(--spacing)*8)] not-data-[shown]:opacity-0"
  inert
>
  <span class="pb-0.5">Следующий кейс</span>
  <Arrow rotate={45} />
</a>

<script>
  const anchor = document.getElementById('case-title');
  const bar = document.getElementById('next-case');

  const footer = document.getElementById('site-footer');

  if (anchor && bar) {
    // Показываем, когда название кейса ушло вверх, и прячем у футера
    let pastAnchor = false;
    let nearFooter = false;
    const render = () => {
      const show = pastAnchor && !nearFooter;
      bar.toggleAttribute('data-shown', show);
      bar.inert = !show;
    };

    new IntersectionObserver(([entry]) => {
      pastAnchor = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      render();
    }).observe(anchor);

    if (footer) {
      new IntersectionObserver(([entry]) => {
        nearFooter = entry.isIntersecting;
        render();
      }).observe(footer);
    }
  }
</script>
