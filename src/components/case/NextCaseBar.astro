---
import Arrow from '../Arrow.astro';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<!-- Плашка «Button-bar» из фрейма «Страница проекта - скролл»: появляется, когда шапка кейса ушла из вида -->
<a
  id="next-case"
  href={href}
  class="group/link fixed bottom-6 left-1/2 z-10 flex h-13.5 -translate-x-1/2 items-center gap-3 rounded-bar bg-surface/60 px-4.5 text-next font-medium whitespace-nowrap backdrop-blur-[8px] transition-[opacity,translate] duration-(--dur-slide) ease-(--ease-spring) not-data-[shown]:pointer-events-none not-data-[shown]:translate-y-[calc(100%+var(--spacing)*6)] not-data-[shown]:opacity-0"
  inert
>
  Следующий кейс
  <Arrow rotate={45} />
</a>

<script>
  const anchor = document.getElementById('case-title');
  const bar = document.getElementById('next-case');

  if (anchor && bar) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      bar.toggleAttribute('data-shown', show);
      bar.inert = !show;
    }).observe(anchor);
  }
</script>
