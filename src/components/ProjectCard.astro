---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { tagLabel } from '../data/tags';

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { id, data } = Astro.props.entry;

/*
  Геометрия из макета (карточка 700×440). Картинки лежат в «сцене» от
  y=180 до низа карточки; координаты слоёв переводятся в проценты сцены,
  чтобы коллаж масштабировался на узких экранах и совпадал с макетом на десктопе.
*/
const stage = { top: 180, width: 700, height: 260 };
const cover = { x: 255, y: 189, w: 536 };

const place = ({ x, y, w }: { x: number; y: number; w: number }) =>
  `left:${(x / stage.width) * 100}%;top:${((y - stage.top) / stage.height) * 100}%;width:${(w / stage.width) * 100}%`;

// По ховеру плашки «разъезжаются веером»: наклон усиливается на 4° в ту же сторону
const fanOut = (deg: number) => deg + Math.sign(deg) * 4;
---

<article
  data-card-href={`/cases/${id}`}
  class="group/card relative flex cursor-pointer flex-col overflow-hidden rounded-card-sm bg-surface md:rounded-card outline-offset-4 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-fg md:h-110"
>
  <!-- На телефоне у текста одна минимальная высота (до 3 строк названия и 4 строк описания), чтобы карточки были одной высоты -->
  <div class="flex min-h-59 flex-col gap-5 px-5 pt-5 md:min-h-0 md:max-w-[calc(var(--card-text)+var(--spacing)*14)] md:px-7 md:pt-7">
    <p class="flex flex-wrap items-center gap-2 text-tag font-semibold text-fg/30">
      {data.tags.map((tag, i) => (
        <>
          {i > 0 && <span class="size-1 rotate-45 bg-current" aria-hidden="true" />}
          <span>{tagLabel(tag)}</span>
        </>
      ))}
    </p>
    <!-- Интервал 30 вместо 100% из макета, чтобы два ряда не слипались; -3px сверху и снизу держат однострочное название на месте макета -->
    <h3 class="text-title-sm font-normal md:-my-0.75">
      <a href={`/cases/${id}`} class="outline-none">{data.title}</a>
    </h3>
    <p class="text-body text-fg/60">{data.description}</p>
  </div>

  <!-- Коллаж обрезается правым и нижним краем карточки -->
  <div
    class="relative mt-6 shrink-0 md:absolute md:inset-x-0 md:top-45 md:bottom-0 md:mt-0"
    style={`aspect-ratio:${stage.width}/${stage.height}`}
  >
    <Image
      src={data.cover}
      alt={data.coverAlt}
      widths={[640, 1072, 1600]}
      sizes="(min-width: 768px) 536px, 77vw"
      class="absolute h-auto max-w-none rounded-image outline-4 outline-fg/12 transition-[translate] duration-(--dur-card) ease-(--ease-spring) group-hover/card:-translate-x-1.5 group-hover/card:-translate-y-2.5"
      style={place(cover)}
    />
    {data.layers.map((layer, i) => (
      <Image
        src={layer.src}
        alt=""
        widths={[220, 440]}
        sizes="(min-width: 768px) 220px, 31vw"
        class="absolute h-auto max-w-none origin-top-left rotate-(--r) transition-[rotate,translate] duration-(--dur-card) ease-(--ease-spring) group-hover/card:-translate-y-3 group-hover/card:rotate-(--r-hover)"
        style={`${place(layer)};--r:${layer.rotate}deg;--r-hover:${fanOut(layer.rotate)}deg;transition-delay:${i * 40}ms`}
      />
    ))}
  </div>
</article>
