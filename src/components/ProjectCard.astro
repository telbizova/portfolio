---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { tagLabel } from '../data/tags';
import { noWidow, typograf } from '../lib/typograf.mjs';

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { id, data } = Astro.props.entry;

/*
  Обложка карточки — слои из папки кейса: cover-bg.png (фон) и cover-card-1.png,
  cover-card-2.png… поверх него. Все слои одного размера с прозрачностью и уже
  расставлены, поэтому просто кладутся друг на друга в порядке номеров.
*/
const coverFiles = import.meta.glob<{ default: ImageMetadata }>('/src/content/cases/*/cover-*.png', { eager: true });
const layerOrder = (path: string) => (path.endsWith('/cover-bg.png') ? 0 : Number(path.match(/cover-card-(\d+)\.png$/)?.[1] ?? 99));
const layers = Object.entries(coverFiles)
  .filter(([path]) => path.startsWith(`/src/content/cases/${id}/`))
  .sort(([a], [b]) => layerOrder(a) - layerOrder(b))
  .map(([, file]) => file.default);
---

<article
  data-card-href={`/cases/${id}`}
  class="group/card relative flex cursor-pointer flex-col overflow-hidden rounded-card-sm bg-surface md:rounded-card outline-offset-4 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-fg md:h-110"
>
  <div class="flex flex-col gap-3 px-6 pt-6 md:max-w-[calc(var(--card-text)+var(--spacing)*14)] md:gap-5 md:px-7 md:pt-7">
    <p class="flex flex-wrap items-center gap-2 text-tag font-semibold text-fg/30">
      {data.tags.map((tag, i) => (
        <>
          {i > 0 && <span class="size-1 rotate-45 bg-current" aria-hidden="true" />}
          <span>{tagLabel(tag)}</span>
        </>
      ))}
    </p>
    <h3 class="text-title-xs font-normal text-balance md:text-title-sm">
      <a href={`/cases/${id}`} class="outline-none">{typograf(data.title)}</a>
    </h3>
    <p class="text-body-sm text-fg/60 md:text-body">{noWidow(typograf(data.description))}</p>
  </div>

  <!-- Обложка из слоёв 672×282, прижата к правому и нижнему краю карточки 700×440 (как Image в макете); по ховеру слои разъезжаются каскадом, смещения — --cover-shift-* в tokens.css -->
  <!--
    На телефоне — та же обложка, что на десктопе, в масштабе 80% (--cover-mobile-width),
    кадрированная так, чтобы группа плашек стояла по центру карточки (coverFocus в кейсе)
  -->
  <div class="card-cover pointer-events-none relative w-(--cover-mobile-width) max-w-none shrink-0 md:absolute md:right-0 md:bottom-0 md:left-7 md:m-0 md:w-auto" style={`--focus:${data.coverFocus};--top:${data.coverTop}`} aria-hidden="true">
    {layers.map((layer, i) => (
      <Image
        src={layer}
        alt=""
        widths={[672, 1344]}
        sizes="(min-width: 768px) 672px, 538px"
        class:list={['card-cover__layer', i > 0 && 'absolute inset-0', (i === 0 || data.coverBottom.includes(i)) && 'card-cover__layer--bleed']}
        style={`--i:${i}`}
      />
    ))}
  </div>
</article>
