---
import Arrow from './Arrow.astro';
---

<!-- Кнопка «Наверх» из скролл-фреймов: 44×44 слева внизу, появляется после прокрутки -->
<button
  id="scroll-top"
  type="button"
  aria-label="Наверх"
  class="group/link fixed bottom-8 left-8 z-10 hidden size-11 items-center justify-center rounded-square bg-accent pb-0.5 text-surface transition-[opacity,translate,background-color,scale] duration-(--dur-slide) ease-(--ease-spring) hover:bg-fg active:scale-97 not-data-[shown]:pointer-events-none not-data-[shown]:translate-y-[calc(100%+var(--spacing)*8)] not-data-[shown]:opacity-0 sm:flex"
  inert
>
  <Arrow rotate={315} />
</button>

<script>
  const button = document.getElementById('scroll-top');

  if (button) {
    const update = () => {
      const show = window.scrollY > window.innerHeight * 0.6;
      button.toggleAttribute('data-shown', show);
      button.inert = !show;
    };

    button.addEventListener('click', () => window.scrollTo({ top: 0 }));
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
