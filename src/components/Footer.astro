---
interface Props {
  // Отступ от футера до низа страницы по макету: 50px на главной, 40px в кейсе; на телефоне 32
  class?: string;
}

const { class: className } = Astro.props;
const year = new Date().getFullYear();

/*
  Рукописные подчёркивания для ссылки на имя (viewBox 310×40, линия
  растягивается по ширине текста; текст находится выше, на y ≈ −45…−5).
  Это шесть разных жестов, а не варианты одной волны: на каждое наведение —
  следующий по кругу, соседние в списке намеренно непохожи.
*/

// Петельки, как прописная «е»: удлинённая циклоида с неровной высотой
const loops = (() => {
  const count = 5;
  const step = 294 / (count * 2 * Math.PI);
  const points: string[] = [];
  for (let i = 0; i <= count * 40; i++) {
    const t = (i / 40) * 2 * Math.PI;
    const height = 20 * (1 + 0.15 * Math.sin(t * 0.37 + 1));
    const x = 8 + step * t - 17 * Math.sin(t);
    const y = 32 - height * Math.cos(t);
    points.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
  }
  return `M${points.join('L')}`;
})();

const strokes = [
  // волна с нарастающей амплитудой
  'M6 21C20 18 32 16 46 19C60 22 68 26 84 24C100 22 108 13 126 13C144 13 150 28 170 29C190 30 198 11 218 10C238 9 244 30 264 31C282 32 292 16 305 12',
  // петельки
  loops,
  // имя обведено овалом, конец заходит за начало
  'M60 -58C150 -72 306 -64 328 -22C340 14 230 32 140 30C50 28 -20 10 -16 -24C-12 -58 90 -70 200 -62',
  // острый зигзаг
  'M5 27L19 9L33 30L49 8L63 29L80 10L94 31L111 9L126 28L142 8L158 30L173 10L189 29L205 8L220 30L237 10L252 28L268 9L283 29L305 12',
  // подчёркнуто трижды: туда, обратно и снова туда
  'M6 13C100 7 220 8 304 12C296 19 60 23 18 31C110 36 215 39 298 50',
  // один быстрый росчерк
  'M4 27C60 19 150 13 232 14C262 14 288 16 306 20',
];
---

<!-- Компонент «Footer» из макета: 40px от контента -->
<footer id="site-footer" class:list={['mt-8 px-4 text-center md:mt-10', className]}>
  <p class="text-footer text-fg/50">
    © {year},{' '}
    <a
      href="https://t.me/telbizova"
      target="_blank"
      rel="noopener"
      class="link-draw"
      data-strokes={JSON.stringify(strokes)}
    >
      <span class="link-draw__label">Валентина Тельбизова</span>
      <svg class="link-draw__svg" viewBox="0 0 310 40" preserveAspectRatio="none" aria-hidden="true">
        <path pathLength="1" d={strokes[0]} />
      </svg>
      <span class="sr-only"> в Telegram (откроется в новой вкладке)</span>
    </a>
  </p>
</footer>

<script>
  // На каждое новое наведение — следующая линия по кругу
  document.querySelectorAll<HTMLElement>('.link-draw[data-strokes]').forEach((link) => {
    const strokes: string[] = JSON.parse(link.dataset.strokes!);
    const path = link.querySelector('path');
    let current = -1;

    const next = () => {
      if (!path) return;
      current = (current + 1) % strokes.length;
      path.setAttribute('d', strokes[current]);
    };

    link.addEventListener('pointerenter', next);
    link.addEventListener('focus', next);
  });
</script>
