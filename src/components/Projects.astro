---
import { getCollection } from 'astro:content';
import { companies } from '../data/companies';
import CompanyIcon from './CompanyIcon.astro';
import ProjectCard from './ProjectCard.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);

// Проекты сгруппированы по компаниям: над группой — компания и период работы
const groups = companies
  .map((company) => ({ company, cases: cases.filter((entry) => entry.data.company === company.id) }))
  .filter((group) => group.cases.length);
---

<div id="projects" class="flex scroll-mt-10 flex-col gap-10">
  {groups.map(({ company, cases }) => (
    <section aria-labelledby={`company-${company.id}`} class="flex flex-col gap-5">
      <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-2 px-6 md:gap-x-3 md:px-7" data-reveal>
        <h2 id={`company-${company.id}`} class="flex items-center gap-2 text-meta font-medium text-company">
          {company.url ? (
            <a href={company.url} target="_blank" rel="noopener" class="company-link group/link flex items-center gap-2 outline-offset-4">
              <CompanyIcon />
              <span class="underline decoration-transparent decoration-1 underline-offset-4 transition-[text-decoration-color] duration-(--dur-micro) ease-(--ease-out) group-hover/link:decoration-current group-focus-visible/link:decoration-current">
                {company.name}
              </span>
              <span class="sr-only">(откроется в новой вкладке)</span>
            </a>
          ) : (
            <>
              <CompanyIcon />
              {company.name}
            </>
          )}
        </h2>
        <p class="text-meta text-muted/60">
          <span class="md:hidden">{company.periodShort}</span>
          <span class="hidden md:inline">{company.period}</span>
        </p>
      </div>

      <ul class="flex flex-col gap-5">
        {cases.map((entry) => (
          <li data-reveal="card">
            <ProjectCard entry={entry} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<script>
  // Карточка кликабельна целиком, но текст в ней можно выделить и скопировать:
  // переход только по клику без выделения. С клавиатуры работает ссылка в заголовке.
  document.querySelectorAll<HTMLElement>('[data-card-href]').forEach((card) => {
    card.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) return;
      if (window.getSelection()?.toString()) return;

      const href = card.dataset.cardHref!;
      if (event.metaKey || event.ctrlKey) window.open(href, '_blank');
      else window.location.href = href;
    });
  });
</script>
